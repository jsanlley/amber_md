#!/bin/bash
#path = 'net/gpfs-amarolab/jsanlleyhernandez/mpro_md/mpro_apo/mpro_apo_dimer/prod/1/'


#make script
cat > combine_traj_to_pdb.cpptraj << EOF
parm .prmtop 			#load topology
trajin .nc 1 last 100 		#load trajectory, change <start> last <offset> to desired interval
autoimage			#align
strip :WAT,Cl-,Na+		#dry (optional)
trajout _combined.pdb pdb 	#output dry pdb from sliced traj
EOF

