#load protein force field
source leaprc.protein.ff14SB
source leaprc.water.tip3p
source leaprc.gaff

#load prepin file for capped amino acid residue
loadamberprep nirm_capped.prepin

#load frcmod files for protein and small molecule force fields
loadamberparams nirm_capped_ff14SB.frcmod
loadamberparams nirm_capped_gaff.frcmod

#load pdb file
pdb = loadpdb mpro_nirm_monomer.pdb

#solvate system
solvateoct pdb TIP3PBOX 10

#neutralize charges
addionsrand pdb Na+ 4

#check pdb file
check pdb

#save topology files (check model)
saveamberparm pdb mpro_nirm_monomer_solvated.prmtop mpro_nirm_monomer_solvated.inpcrd
savepdb pdb mpro_nirm_monomer_solvated.pdb

quit
