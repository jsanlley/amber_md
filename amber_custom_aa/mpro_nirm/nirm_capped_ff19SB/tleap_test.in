source leaprc.gaff
source leaprc.water.opc
source leaprc.protein.ff19SB

loadamberprep nirm_capped.prepin
loadamberparams nirm_capped_ff19SB.frcmod
loadamberparams nirm_capped_gaff.frcmod


pdb = loadpdb mpro_nirm_monomer.pdb
solvateoct pdb OPCBOX 10 iso

addionsrand pdb Na+ 53 Cl- 53           #0.150M salt conc.
addionsrand pdb Na+ 4

saveoff pdb mpro_nirm_solvated.lib                     #save off files
saveamberparm pdb mpro_nirm_solvated.prmtop mpro_nirm_solvated.inpcrd       #save parm
savepdb pdb mpro_nirm_solvated.pdb                           #save pdb

